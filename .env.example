# Azure DevOps Configuration
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-organization
AZURE_DEVOPS_PAT=your-personal-access-token
AZURE_DEVOPS_PROJECT=your-project-name
AZURE_DEVOPS_REPOSITORY=your-repo-name

# ── LLM Configuration ─────────────────────────────────────────
# Primary: Azure AI Foundry (GPT 5.x models from the model catalog)
LLM_PROVIDER=azure_ai_foundry      # azure_ai_foundry | azure_openai | openai | anthropic

# Azure AI Foundry (default)
AZURE_AI_FOUNDRY_ENDPOINT=https://your-project.services.ai.azure.com
AZURE_AI_FOUNDRY_API_KEY=your-foundry-api-key
AZURE_AI_FOUNDRY_MODEL=gpt-5.3     # model deployment name (gpt-5.3, gpt-4o, grok-3, etc.)
AZURE_AI_FOUNDRY_API_VERSION=2025-04-01-preview

# ── Agent Configuration ───────────────────────────────────────
MAX_FILES_PER_REQUEST=20            # max files to fetch per agent invocation
MAX_TOKENS_CONTEXT=120000           # max tokens to feed into reasoning context (GPT 5.3 supports ~400k)
DEFAULT_BRANCH=main                 # default branch to read from
LOG_LEVEL=INFO

# ── Webhook Receiver / Pipeline Trigger ──────────────────────
AGENT_PIPELINE_ID=42                # ID of the webhook-trigger pipeline in Azure DevOps

# ── ProGet Package Index ─────────────────────────────────────
# Used by uv to resolve Python packages from your org's ProGet feed.
# The index URL is defined in pyproject.toml [tool.uv.index].
# Credentials are passed via UV_HTTP_BASIC_* env vars.
PROGET_PYPI_URL=https://proget.your-org.com/pypi/python-packages/simple/
PROGET_USERNAME=api                 # usually "api" for API key auth
PROGET_API_KEY=your-proget-api-key
