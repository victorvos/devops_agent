# ── Azure DevOps Configuration ───────────────────────────────
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-organization
AZURE_DEVOPS_PROJECT=your-project-name
AZURE_DEVOPS_REPOSITORY=your-repo-name

# Auth mode: "managed_identity" (Container App) | "system_token" (pipeline/CI)
DEVOPS_AUTH_MODE=managed_identity

# Managed Identity — client ID set automatically by Bicep deployment
# MANAGED_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000

# System token — injected by Azure Pipelines automatically
# SYSTEM_ACCESS_TOKEN=

# ── LLM Configuration ─────────────────────────────────────────
LLM_PROVIDER=azure_ai_foundry
AZURE_AI_FOUNDRY_ENDPOINT=https://your-project.services.ai.azure.com
AZURE_AI_FOUNDRY_API_KEY=your-foundry-api-key
AZURE_AI_FOUNDRY_MODEL=gpt-5.3
AZURE_AI_FOUNDRY_API_VERSION=2025-04-01-preview

# ── Agent Configuration ───────────────────────────────────────
MAX_FILES_PER_REQUEST=20
MAX_TOKENS_CONTEXT=120000
DEFAULT_BRANCH=main
# Prefix for agent-created branches; trailing slash optional (default: feature_ai → feature_ai/feature_skeleton/123)
BRANCH_PREFIX=feature_ai
LOG_LEVEL=INFO

# ── Optional: Service Bus (for queue-based processing) ───────
# Not needed for direct mode — only set these if deployServiceBus=true
# SERVICE_BUS_CONNECTION_STR=Endpoint=sb://devops-agent-sb.servicebus.windows.net/;SharedAccessKeyName=...
# SERVICE_BUS_QUEUE_NAME=agent-requests

# ── Optional: Key Vault ──────────────────────────────────────
# KEY_VAULT_URL=https://devops-agent-kv.vault.azure.net

# ── ProGet Package Index ─────────────────────────────────────
PROGET_PYPI_URL=https://proget.your-org.com/pypi/python-packages/simple/
PROGET_USERNAME=api
PROGET_API_KEY=your-proget-api-key
